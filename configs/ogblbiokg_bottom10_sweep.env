# Short sweep focusing on weakest relations (from debug/relation_metrics.json at step ~28k).
MODE=train
MODEL_NAME=RelatE
DATASET_NAME=ogbl-biokg
DATA_PATH=./data/ogb/ogbl_biokg_kge_int
SAVE_ID=ogblbiokg_rel_bottom10_sweep

# Core hyperparameters
BATCH_SIZE=1024
NEGATIVE_SAMPLE_SIZE=3072
MAX_NEGATIVE_SAMPLE_SIZE=4096
HIDDEN_DIM=1024
GAMMA=18
ADVERSARIAL_TEMPERATURE=1.2
LEARNING_RATE=0.0001
MAX_STEPS=10000
VALID_STEPS=1000
SAVE_CHECKPOINT_STEPS=5000
LOG_STEPS=200

# Upweight bottom-10 relations and mine hard negatives on them.
RELATION_SAMPLING_WEIGHTS=./configs/ogblbiokg_bottom10_sampling.json
EXTRA_HARD_RELATIONS="75 24 16 66 35 86 15 67 83 29"
HARD_NEGATIVE_STEPS="0 3000 6000"
HARD_NEGATIVE_MULTIPLIER=1.35
HARD_NEGATIVE_FRACTION=0.8
STRUCTURAL_NEGATIVE_FRACTION=0.0
RELATION_METRICS_PATH=./debug/relation_metrics_bottom10.json
EVAL_PREDICTIONS_PATH=./debug/eval_predictions_bottom10.jsonl
HARD_NEGATIVE_LOG_PATH=./debug/hard_negatives_bottom10.jsonl

# Keep other regularization/lr controls reasonable for the short sweep.
REGULARIZATION=0.00015
WEIGHT_DECAY=2e-5
WARM_UP_STEPS=2000
WARM_UP_FACTOR=1.0
WARM_UP_MULTIPLIER=2
PLATEAU_LR_START_STEP=4000
PLATEAU_LR_PATIENCE=1
PLATEAU_LR_FACTOR=0.5
PLATEAU_LR_MIN=5e-5
LR_DROP_STEPS="30000 50000"
GRADIENT_ACCUMULATION_STEPS=4
TEST_BATCH_SIZE=16
