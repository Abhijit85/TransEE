# RelatE training defaults stored as pure KEY=VALUE pairs.

MODE=train
MODEL_NAME=RelatE
GPU_DEVICE=1,2,3,4  #GPU 0-7 are there please run the GPU usage script 'bash scripts/gpu_usage.sh USAGE/gpu_usage.txt' for availability.
CODE_PATH=Code
DATA_ROOT=data
SAVE_ROOT=model_tuned

MAX_STEPS=300000
TEST_BATCH_SIZE=16
VALID_STEPS=20000
SAVE_CHECKPOINT_STEPS=5000
LOG_STEPS=500
TEST_LOG_STEPS=2500
EARLY_STOP_PATIENCE=5
GRADIENT_ACCUMULATION_STEPS=1

DOUBLE_ENTITY_EMBEDDING=true
DOUBLE_RELATION_EMBEDDING=true
USE_ADVERSARIAL_SAMPLING=true

# ogbl-biokg training defaults (resume from latest RelatE checkpoint)
DATASET_NAME=ogbl-biokg
DATA_PATH=./data/ogb/ogbl_biokg_kge
SAVE_ID=ogblbiokg_rel
BATCH_SIZE=2048
NEGATIVE_SAMPLE_SIZE=2048
HIDDEN_DIM=2048
GAMMA=12
ALPHA=1.2
LEARNING_RATE=0.0001
TYPE_MAP_PATH=./data/ogb/ogbl_biokg_kge/entity_type_map.json
TYPE_LAMBDA=0.1
INVERSE_MAP_PATH=./data/ogb/ogbl_biokg_kge/relation_inverse_map.json

# Multi-hop/path curriculum tuned for ogbl-biokg
PATH_LOSS_WEIGHT=0
PATH_BATCH_SIZE=256
PATH_NEGATIVE_SIZE=16
PATH_HOPS="2 3"
PATH_MAX_PER_HOP=5000
PATH_CONSISTENCY_WEIGHT=0.1
PATH_MARGIN=1.0
PATH_CONSISTENCY_MARGIN=0.5
PATH_CURRICULUM_STEPS="5000 200000"
