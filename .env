# RelatE training defaults stored as pure KEY=VALUE pairs.

MODE=train
MODEL_NAME=RelatE
GPU_DEVICE=2,3,6
CODE_PATH=Code
DATA_ROOT=data
SAVE_ROOT=model_tuned

MAX_STEPS=300000
TEST_BATCH_SIZE=16
VALID_STEPS=5000
SAVE_CHECKPOINT_STEPS=5000
LOG_STEPS=500
TEST_LOG_STEPS=2500
EARLY_STOP_PATIENCE=5

DOUBLE_ENTITY_EMBEDDING=true
DOUBLE_RELATION_EMBEDDING=true
USE_ADVERSARIAL_SAMPLING=true

DATASET_NAME=ogbl-biokg
DATA_PATH=./data/ogb/ogbl_biokg_kge
SAVE_ID=ogblbiokg_rel
BATCH_SIZE=2048
NEGATIVE_SAMPLE_SIZE=2048
HIDDEN_DIM=1024
GAMMA=12
ALPHA=1.2
LEARNING_RATE=0.0001
TYPE_MAP_PATH=
TYPE_LAMBDA=0.1
