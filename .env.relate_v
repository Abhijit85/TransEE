# RelateV single-model profile (Code_relate_v)

MODEL_NAME=RelateV
DATASET_NAME=wn18rr
GPU_DEVICE=6,7
SAVE_ID=wn18rr_relate_v

# Core hyperparameters
BATCH_SIZE=256
NEGATIVE_SAMPLE_SIZE=3072
HIDDEN_DIM=1024
GAMMA=16
ALPHA=1.5
LEARNING_RATE=2e-4
MAX_STEPS=80000
TEST_BATCH_SIZE=16

# Use the copied dataset bundle for this branch
DATA_PATH=./data_relate_v/wn18rr
TYPE_MAP_PATH=./data_relate_v/wn18rr_entity_type_map.json
TYPE_LAMBDA=0.2

# Keep RelateV profile behavior enabled (set 0 to disable profile defaults)
RELATEV_APPLY_PROFILE=1

# Optional training stack overrides
WEIGHT_DECAY=3e-5
GRAD_CLIP_NORM=1.0
USE_LOOKAHEAD=1
LOOKAHEAD_STEPS=5
LOOKAHEAD_ALPHA=0.5
USE_EMA=1
EMA_DECAY=0.999
EVAL_WITH_EMA=1

# Eval/training cadence
MURP_STYLE_REPORTING=0
EARLY_STOP_PATIENCE=8
VALID_STEPS=1500
LOG_STEPS=100
PLATEAU_LR_START_STEP=5000
PLATEAU_LR_PATIENCE=1
PLATEAU_LR_FACTOR=0.7
PLATEAU_LR_MIN=5e-5
